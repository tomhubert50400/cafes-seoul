# ==============================================
# REQUIRED: Supabase Authentication
# ==============================================
# Get these from your Supabase project settings: https://supabase.com/dashboard
# These are REQUIRED for authentication to work
NEXT_PUBLIC_SUPABASE_URL=-------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=-------------------------------------------

# Service role key - ONLY use in server-side scripts, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=-------------------------------------------

# ==============================================
# REQUIRED: App Configuration
# ==============================================
# Required for OAuth callback redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CafesSeoul

# ==============================================
# Kakao Maps API
# ==============================================
# Get this from Kakao Developers: https://developers.kakao.com
# JavaScript API Key (for web maps)
NEXT_PUBLIC_KAKAO_MAPS_API_KEY=-------------------------------------------
# REST API Key (for server-side operations)
KAKAO_REST_API_KEY=-------------------------------------------

# ==============================================
# Google Cloud Translation API (for cafe import script)
# ==============================================
GOOGLE_TRANSLATE_API_KEY=-------------------------------------------

# ==============================================
# OPTIONAL: Analytics
# ==============================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
